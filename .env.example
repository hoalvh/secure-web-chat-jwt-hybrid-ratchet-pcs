# Server
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://secure_chat:secure_chat@localhost:5432/secure_chat

# JWT
JWT_ISSUER=secure-chat-server
JWT_AUDIENCE=secure-chat-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token cookie
REFRESH_COOKIE_NAME=secure_chat_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

