# Server
APP_ENV=development
HOST=127.0.0.1
PORT=8000
SECURE_CHAT_DATA_DIR=./data

# Database
# Local default (leave unset): SQLite file under SECURE_CHAT_DATA_DIR.
# Deploy: paste a managed Postgres connection string (Neon, Supabase, Render...).
# DATABASE_URL=sqlite:///./data/secure_chat.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Production hardening (behind HTTPS)
# COOKIE_SECURE=true                       # send refresh cookie only over HTTPS
# CORS_ORIGINS=https://yourdomain.com      # extra allowed browser origins, comma separated

# JWT
JWT_SECRET=change-this-for-local-demo
JWT_ISSUER=secure-chat-server
JWT_AUDIENCE=secure-chat-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token cookie
REFRESH_COOKIE_NAME=secure_chat_refresh
REFRESH_TOKEN_TTL_SECONDS=604800
